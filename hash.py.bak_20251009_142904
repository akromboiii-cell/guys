            digits = re.sub(r"\D", "", (message.text or ""))
            if len(digits) < 4:
                await message.answer("Kod noto'g'ri format. Iltimos Telegramdan kelgan kodni yuboring.")
                return
            try:
                await client.sign_in(phone=phone, code=digits)
            except SessionPasswordNeededError:
                pending['need_password'] = True
                await message.answer("2FA parol talab qilinmoqda. Iltimos parolni yuboring.")
                return
            except PhoneCodeInvalidError:
                await message.answer("Kod noto'g'ri. Iltimos yangi kod oling (kontaktni qayta yuboring).")
                return
            except PhoneCodeExpiredError:
                await message.answer("Kod eskirgan. Iltimos kontaktni qayta yuboring.")
                return
            except Exception as e:
                logger.exception("sign_in error: %s", e)
                await message.answer("Sign-in xatosi. Iltimos /reset_session bilan qayta urin yoki admin bilan bog'laning.")
                try:
                    await client.disconnect()
                except:
                    pass
                active_signins.pop(int(message.from_user.id), None)
                return

        try:
            me = await client.get_me()
            meta = {'api_id': GLOBAL_API_ID, 'api_hash': GLOBAL_API_HASH, 'created_at': datetime.now(timezone.utc).isoformat()}
            with open(user_base(int(message.from_user.id)) + ".meta.json", "w", encoding="utf-8") as f:
                json.dump(meta, f, ensure_ascii=False, indent=2)
            users[uid] = users.get(uid, {})
            users[uid]['session'] = True
            users[uid].pop('status', None)
            users[uid].setdefault('plan', 'free')
            users[uid].setdefault('groups', [])
            users[uid].setdefault('interval_minutes', FREE_DEFAULT_MINUTES)
            save_json(USERS_FILE, users)
            try:
                await client.disconnect()
            except:
                pass
            active_signins.pop(int(message.from_user.id), None)
            started, info = await ensure_worker_running(int(message.from_user.id))
            if started:
                await message.answer("Avtorizatsiya muvaffaqiyatli. Userbot ishga tushdi.", reply_markup=main_kb())
            else:
                if info == "database_locked":
                    await message.answer("Session fayli band edi; zaxiraga olindi. Iltimos /start orqali qayta urining.", reply_markup=contact_kb())
                elif info == "not_authorized":
                    await message.answer("Session yaratilgan, lekin autorize bo'lmadi. Iltimos /start orqali qayta urin.", reply_markup=contact_kb())
                else:
                    await message.answer("Avtorizatsiya saqlandi, lekin worker ishga tushmadi: " + str(info), reply_markup=main_kb())
        except Exception:
            logger.exception("post-signin finalize error")
            await message.answer("Avtorizatsiya tugagach xatolik yuz berdi. Iltimos /reset_session bilan qayta urin.")
        return

    # ---------- Manage groups ----------
    if text == "Manage groups ⚙️":
        await message.answer("Guruhlarni boshqarish:", reply_markup=manage_groups_kb())
        return

    if text == "Add group ➕":
        users[uid]['await_add_group'] = True
        save_json(USERS_FILE, users)
        await message.answer("Guruh invite link yoki @username yuboring. (Cancel ❌ bilan chiqish)", reply_markup=simple_cancel_kb())
        return

    if text == "Remove group ➖":
        users[uid]['await_remove_group'] = True
        save_json(USERS_FILE, users)
        await message.answer("O'chirmoqchi bo'lgan guruh ssilkasi yoki nomini yuboring. (Cancel ❌ bilan chiqish)", reply_markup=simple_cancel_kb())
        return

    if text == "List groups 📋":
        groups = users.get(uid, {}).get('groups', []) or []
        if not groups:
            await message.answer("Ro'yxat bo'sh.", reply_markup=main_kb())
        else:
            lines = [f"{i+1}. {g.get('title')} (id:{g.get('id')})" for i,g in enumerate(groups)]
            await message.answer("Sizning guruhlaringiz:\n" + "\n".join(lines), reply_markup=main_kb())
        return

    # Add group actual
    if users.get(uid, {}).get('await_add_group'):
        if text == "Cancel ❌":
            users[uid].pop('await_add_group', None)
            save_json(USERS_FILE, users)
            await message.answer("Bekor qilindi.", reply_markup=main_kb())
            return
        if not users.get(uid, {}).get('session'):
            await message.answer("Iltimos avval /start orqali avtorizatsiya qiling va userbotni ishga tushiring.", reply_markup=contact_kb())
            users[uid].pop('await_add_group', None)
            save_json(USERS_FILE, users)
            return
        started, info = await ensure_worker_running(int(uid))
        if not started:
            await message.answer("Worker ishlamayapti: " + str(info), reply_markup=main_kb())
            users[uid].pop('await_add_group', None)
            save_json(USERS_FILE, users)
            return
        sw = active_workers.get(int(uid))
        try:
            ent = await sw.client.get_entity(text)
            gid = getattr(ent, "id", None)
            title = getattr(ent, "title", getattr(ent, "username", str(gid)))
            groups = users[uid].get('groups', [])
            if any(g.get('id') == gid for g in groups):
                await message.answer("Bu guruh allaqachon ro'yxatda.", reply_markup=main_kb())
            else:
                groups.append({'id': gid, 'title': title})
                users[uid]['groups'] = groups
                save_json(USERS_FILE, users)
                await message.answer(f"Saqlandi ✅ — {title}", reply_markup=main_kb())
        except Exception:
            logger.exception("add group resolve error")
            await message.answer("Guruhni topib bo'lmadi. Iltimos haqiqiy invite link yoki @username yuboring.", reply_markup=main_kb())
        users[uid].pop('await_add_group', None)
        save_json(USERS_FILE, users)
        return

    # Remove group actual
    if users.get(uid, {}).get('await_remove_group'):
        if text == "Cancel ❌":
            users[uid].pop('await_remove_group', None)
            save_json(USERS_FILE, users)
            await message.answer("Bekor qilindi.", reply_markup=main_kb())
            return
        tt = text
        groups = users[uid].get('groups', [])
        removed = False
        for g in list(groups):
            if str(g.get('id')) == tt or tt.lower() in str(g.get('title','')).lower() or (tt.startswith('@') and tt.lower() == str(g.get('title','')).lower()):
                groups.remove(g)
                removed = True
        if removed:
            users[uid]['groups'] = groups
            save_json(USERS_FILE, users)
            await message.answer("O'chirildi ✅", reply_markup=main_kb())
        else:
            await message.answer("Ro'yxatda mos guruh topilmadi.", reply_markup=main_kb())
        users[uid].pop('await_remove_group', None)
        save_json(USERS_FILE, users)
        return

    # ---------- Forword menu ----------
    if text == "Forword ⏩":
        # determine current true status from users dict
        u = users.get(uid, {})
        is_premium = (u.get("plan") == "premium")
        await message.answer("Forword menyusi:", reply_markup=forward_menu_kb(is_premium))
        return

    # Free Trial
    if text == "Free Trial":
        users[uid] = users.get(uid, {})
        users[uid]['plan'] = 'free'
        users[uid]['promo'] = users[uid].get('promo', False)  # keep promo flag as is
        users[uid]['interval_minutes'] = FREE_DEFAULT_MINUTES
        save_json(USERS_FILE, users)
        await message.answer("✅ FREE TRIAL aktiv: 30 daqiqa, maksimal 3 guruh. Endi 'Habar yozish uchun' guruhiga yozing.", reply_markup=main_kb())
        return

    # Premium Trial -> require promo or manual buy
    if text == "Premium Trial":
        # ask for promo code if user doesn't already have premium
        u = users.get(uid, {})
        if u.get('plan') == 'premium':
            await message.answer("Siz allaqachon premium foydalanuvisiz.", reply_markup=main_kb())
            return
        # set flag to await promo
        users[uid]['awaiting_promo'] = True
        save_json(USERS_FILE, users)
        await message.answer("Iltimos, promo kodni yuboring yoki admin bilan bog'laning. (Cancel ❌ bilan chiqish)", reply_markup=simple_cancel_kb())
        return

    # handle promo code submission
    if users.get(uid, {}).get('awaiting_promo'):
        if text == "Cancel ❌":
            users[uid].pop('awaiting_promo', None)
            save_json(USERS_FILE, users)
            await message.answer("Bekor qilindi.", reply_markup=main_kb())
            return
        code = (text or "").strip()
        found = None
        for p in promos:
            if p['code'] == code:
                found = p
                break
        if not found:
            await message.answer("Promo topilmadi yoki noto'g'ri kod. Admin bilan bog'laning.", reply_markup=main_kb())
            users[uid].pop('awaiting_promo', None)
            save_json(USERS_FILE, users)
            return
        if found.get('used'):
            await message.answer("Bu promo allaqachon ishlatilgan.", reply_markup=main_kb())
            users[uid].pop('awaiting_promo', None)
            save_json(USERS_FILE, users)
            return
        # mark promo used and grant premium
        found['used'] = True
        found['used_by'] = int(uid)
        found['used_at'] = datetime.now(timezone.utc).isoformat()
        users[uid]['plan'] = 'premium'
        users[uid]['promo'] = True
        users[uid]['last_used_promo'] = code
        save_json(PROMO_FILE, promos)
        save_json(USERS_FILE, users)
        users[uid].pop('awaiting_promo', None)
        # ensure worker started and interval set
        users[uid].setdefault('interval_minutes', 1)
        save_json(USERS_FILE, users)
        await ensure_worker_running(int(uid))
        await message.answer("✅ Promo qabul qilindi. Siz endi PREMIUM bo'ldingiz. /restime orqali intervalni sozlang.", reply_markup=main_kb())
        return

    # Boshlash (premium)
    if text == "Boshlash ▶️":
        if users.get(uid, {}).get('plan') != 'premium':
            await message.answer("Boshlash faqat premium uchun. Premiumga o'tish uchun Premium Trialni tanlang.", reply_markup=main_kb())
            return
        if not users.get(uid, {}).get('interval_minutes'):
            await message.answer("Iltimos /restime <minutes> orqali intervalni belgilang.", reply_markup=main_kb())
            return
        await message.answer(f"Premium aktiv: interval {users[uid]['interval_minutes']} daqiqa. Endi 'Habar yozish uchun' guruhiga yozing.", reply_markup=main_kb())
        return

    # Cancel universal
    if text in ("Cancel ❌", "❌ Bekor qilish"):
        for k in ['await_add_group', 'await_remove_group', 'awaiting_promo', 'awaiting_interval']:
            users[uid].pop(k, None)
        save_json(USERS_FILE, users)
        await message.answer("Bekor qilindi.", reply_markup=main_kb())
        return

    # /restime handling
    if (text.lower().startswith("/restime") or text.lower() == "restime"):
        parts = text.split()
        if users.get(uid, {}).get('plan') != 'premium':
            await message.answer("Bu buyruq faqat premium foydalanuvchilar uchun.")
            return
        if len(parts) == 2:
            try:
                val = int(parts[1])
                if val < 1:
                    await message.answer("Interval minimal 1 daqiqa.")
                    return
                users[uid]['interval_minutes'] = val
                save_json(USERS_FILE, users)
                await ensure_worker_running(int(uid))
                await message.answer(f"Interval yangilandi: {val} daqiqa.")
                return
            except Exception:
                await message.answer("Xato format. Misol: /restime 5")
                return
        else:
            users[uid]['awaiting_interval'] = True
            save_json(USERS_FILE, users)
            await message.answer("Iltimos interval (daqiqalarda) kiriting:", reply_markup=simple_cancel_kb())
            return

    if users.get(uid, {}).get('awaiting_interval'):
        txt = (message.text or "").strip()
        if txt in ("Cancel ❌",):
            users[uid].pop('awaiting_interval', None)
            save_json(USERS_FILE, users)
            await message.answer("Bekor qilindi.", reply_markup=main_kb())
            return
        try:
            val = int(txt)
            if val < 1:
                await message.answer("Interval minimal 1 daqiqa.")
                return
            users[uid]['interval_minutes'] = val
            users[uid]['plan'] = 'premium'
            users[uid].pop('awaiting_interval', None)
            save_json(USERS_FILE, users)
            await ensure_worker_running(int(uid))
            await message.answer(f"Premium interval belgilandi: {val} daqiqa.", reply_markup=main_kb())
        except Exception:
            await message.answer("Xato format. Iltimos raqam kiriting (masalan: 5).")
        return

    # fallback
    await message.answer("Noma'lum buyruq. /help", reply_markup=main_kb())

# ---------- startup ----------
async def on_startup():
    logger.info("Bot starting...")
    # start workers for existing sessions
    for uid, u in users.items():
        try:
            if u.get('session'):
                asyncio.create_task(ensure_worker_running(int(uid)))
        except Exception:
            logger.exception("startup worker start failed for %s", uid)

if __name__ == "__main__":
    try:
        logger.info("Starting polling...")
        asyncio.run(dp.start_polling(bot, on_startup=on_startup))
    except KeyboardInterrupt:
        logger.info("Stopped by user")
    except Exception:
        logger.exception("Fatal error")
