            lines = []
            for u_id, info in users.items():
                plan = info.get("plan", "free")
                uname = info.get("username") or ""
                lines.append(f"{u_id} — {uname} — {plan}")
            await message.answer("Foydalanuvchilar:\n" + ("\n".join(lines) if lines else "Hech kim yo'q"), reply_markup=admin_kb())
            return

        # revoke premium
        if text == "Premiumni olib tashlash":
            admin_pending['mode'] = 'revoke'
            admin_pending['awaiting_userid'] = True
            await message.answer("Iltimos, premiumni olib tashlamoqchi bo'lgan user id ni kiriting (raqam):", reply_markup=simple_cancel_kb())
            return

        if admin_pending.get('mode') == 'revoke' and admin_pending.get('awaiting_userid'):
            if text == "Cancel ❌":
                admin_pending.clear()
                await message.answer("Bekor qilindi.", reply_markup=admin_kb())
                return
            try:
                target_uid = str(int(text))
            except:
                await message.answer("Xato user id. Iltimos faqat raqam kiriting.")
                return
            if target_uid not in users:
                await message.answer("Bunday foydalanuvchi topilmadi.", reply_markup=admin_kb())
                admin_pending.clear()
                return
            # update both disk and memory: crucial fix
            users[target_uid]['plan'] = 'free'
            users[target_uid]['promo'] = False
            users[target_uid].pop('last_used_promo', None)
            save_json(USERS_FILE, users)
            # If worker exists, it will read users dict next iteration; to be safe, update worker state
            if int(target_uid) in active_workers:
                # no heavy restart required; worker reads users dict periodically
                logger.info("Updated worker state for revoked user %s", target_uid)
            # notify user
            try:
                await bot.send_message(int(target_uid), "❗ Sizning premium huquqlaringiz admin tomonidan olib tashlandi. Siz endi FREE reja bilan ishlaysiz.")
            except Exception:
                logger.exception("notify revoke failed")
            await message.answer(f"User {target_uid} premiumdan mahrum qilindi.", reply_markup=admin_kb())
            admin_pending.clear()
            return

        # broadcast
        if text == "Broadcast (xabar yuborish)":
            admin_pending['mode'] = 'broadcast'
            admin_pending['awaiting_broadcast'] = True
            await message.answer("Iltimos, yuboriladigan xabarni kiriting:", reply_markup=simple_cancel_kb())
            return

        if admin_pending.get('mode') == 'broadcast' and admin_pending.get('awaiting_broadcast'):
            if text == "Cancel ❌":
                admin_pending.clear()
                await message.answer("Bekor qilindi.", reply_markup=admin_kb())
                return
            msg_text = text
            await message.answer("Broadcast yuborilmoqda...")
            count = 0
            for u_id in list(users.keys()):
                try:
                    await bot.send_message(int(u_id), f"📣 Admindan xabar:\n\n{msg_text}")
                    count += 1
                    await asyncio.sleep(0.4)
                except Exception:
                    logger.exception("broadcast to %s failed", u_id)
                    await asyncio.sleep(0.2)
            await message.answer(f"Broadcast tugadi. Yuborildi: {count} ta foydalanuvchiga.", reply_markup=admin_kb())
            admin_pending.clear()
            return

    # admin cancel
    if text == "Cancel ❌" and message.from_user.id == ADMIN_ID:
        admin_pending.clear()
        await message.answer("Bekor qilindi.", reply_markup=admin_kb())
        return

    # ---------- contact sign-in ----------
    if message.contact:
        phone = message.contact.phone_number
        phone_digits = re.sub(r"\D", "", phone)
        phone_norm = "+" + phone_digits if not phone.startswith("+") else "+" + phone_digits
        base = user_base(int(uid))
        client = TelegramClient(base, GLOBAL_API_ID, GLOBAL_API_HASH)
        lock = await ensure_session_lock(int(uid))

        try:
            async with lock:
                attempts = 0
                while True:
                    attempts += 1
                    try:
                        await client.connect()
                        break
                    except Exception as e:
                        msg_err = str(e).lower()
                        logger.exception("client.connect err attempt %s: %s", attempts, e)
                        if "database is locked" in msg_err or isinstance(e, sqlite3.OperationalError):
                            if attempts < 4:
                                await asyncio.sleep(attempts)
                                continue
                            rename_bad_session(int(uid))
                            await message.answer("Sessiya fayli band; zaxiraga olindi. /start orqali qayta boshlang.")
                            try:
                                await client.disconnect()
                            except:
                                pass
                            return
                        else:
                            await message.answer("Serverga ulanishda xatolik. Iltimos keyinroq urin.")
                            try:
                                await client.disconnect()
                            except:
                                pass
                            return

                try:
                    sent = await client.send_code_request(phone_norm)
                except Exception as e:
                    logger.exception("send_code_request failed: %s", e)
                    await message.answer("Kod yuborishda xato (flood yoki boshqa). Iltimos biroz kutib qayta urin.")
                    try:
                        await client.disconnect()
                    except:
                        pass
                    return
        except Exception:
            logger.exception("contact sign-in flow error")
            try:
                await client.disconnect()
            except:
                pass
            await message.answer("Avtorizatsiya boshlashda xato yuz berdi.")
            return

        active_signins[int(uid)] = {'client': client, 'phone': phone_norm, 'need_password': False}
        users[uid] = users.get(uid, {})
        users[uid]['status'] = 'waiting_for_code'
        save_json(USERS_FILE, users)
        await message.answer("Kod yuborildi. Telegramdan kelgan kodni yuboring (masalan: 12.345 yoki 12345).", reply_markup=ReplyKeyboardRemove())
        return

    # ---------- handle pending sign-in ----------
    pending = active_signins.get(int(message.from_user.id))
    if pending:
        client: TelegramClient = pending['client']
        phone: str = pending['phone']
        if pending.get('need_password'):
            pw = (message.text or "").strip()
            if not pw:
                await message.answer("Iltimos 2FA parolni yuboring.")
                return
            try:
                await client.sign_in(password=pw)
            except Exception:
                await message.answer("2FA parol noto'g'ri. Qayta yuboring yoki /reset_session bilan qayta urin.")
                return
