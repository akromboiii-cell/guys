# ---------- helpers ----------
def user_base(uid: int) -> str:
    return os.path.join(SESSIONS_DIR, f"session_{uid}")

def rename_bad_session(uid: int):
    for name in os.listdir(SESSIONS_DIR):
        if name.startswith(f"session_{uid}"):
            src = os.path.join(SESSIONS_DIR, name)
            dst = src + ".bad"
            try:
                os.rename(src, dst)
                logger.info("Renamed locked session: %s -> %s", src, dst)
            except Exception:
                logger.exception("rename bad session failed for %s", src)

def ensure_user_exists(uid: str):
    if uid not in users:
        users[uid] = {}
        save_json(USERS_FILE, users)

async def ensure_session_lock(uid: int) -> asyncio.Lock:
    uid = int(uid)
    if uid not in session_locks:
        session_locks[uid] = asyncio.Lock()
    return session_locks[uid]

# ---------- SessionWorker ----------
class SessionWorker:
    def __init__(self, uid: int, base_path: str, api_id: int, api_hash: str):
        self.uid = int(uid)
        self.base = base_path
        self.api_id = api_id
        self.api_hash = api_hash
        self.client = TelegramClient(self.base, self.api_id, self.api_hash)
        self.last_msg = None
        self.paused = False
        self.source_id = None
        self.repeat_task: Optional[asyncio.Task] = None
        self.running = False

    async def start(self) -> (bool, str):
        lock = await ensure_session_lock(self.uid)
        attempts = 0
        while True:
            attempts += 1
            try:
                async with lock:
                    await self.client.connect()
                    if not await self.client.is_user_authorized():
                        await self.client.disconnect()
                        return False, "not_authorized"
                    break
            except Exception as e:
                err = str(e).lower()
                logger.exception("[%s] client connect failed (attempt %s): %s", self.uid, attempts, err)
                if "database is locked" in err or isinstance(e, sqlite3.OperationalError):
                    if attempts <= 3:
                        await asyncio.sleep(attempts)
                        continue
                    rename_bad_session(self.uid)
                    return False, "database_locked"
                else:
                    return False, "connect_error"

        source = await self._ensure_source()
        if not source:
            try:
                await self.client.disconnect()
            except:
                pass
            return False, "source_error"
        self.source_id = getattr(source, "id", None)

        @self.client.on(events.NewMessage(outgoing=True))
        async def outgoing(event):
            try:
                if getattr(event.chat, "id", None) != self.source_id:
                    return
                msg = event.message
                if (not getattr(msg, "message", None) or str(msg.message).strip() == "") and not getattr(msg, "media", None):
                    return
                txt = (msg.message or "").strip()
                if txt.upper() in ("STOP", "OFF") and (not msg.media) and len(txt.split()) == 1:
                    self.paused = True
                    logger.info("[%s] paused by STOP", self.uid)
                    return
                if self.paused:
                    self.paused = False
                    logger.info("[%s] resumed by user", self.uid)
                self.last_msg = msg
                logger.info("[%s] Message queued, last_msg updated", self.uid)
                # forward now asynchronously
                asyncio.create_task(self._forward_now(msg))
            except Exception:
                logger.exception("Outgoing handler error for %s", self.uid)

        self.repeat_task = asyncio.create_task(self._repeater_loop())
        self.running = True
        logger.info("SessionWorker started for %s", self.uid)
        return True, "started"

    async def _ensure_source(self):
        try:
            async for d in self.client.iter_dialogs(limit=300):
                if getattr(d, "name", None) == SOURCE_TITLE:
                    return d.entity
        except Exception:
            logger.exception("iter_dialogs error")
        try:
            res = await self.client(functions.channels.CreateChannelRequest(
                title=SOURCE_TITLE,
                about="Auto forward source created by bot",
                megagroup=True
            ))
            if hasattr(res, "chats") and res.chats:
                return res.chats[0]
        except Exception:
            logger.exception("CreateChannelRequest error")
        return None

    async def _resolve_targets(self) -> List:
        u = users.get(str(self.uid), {})
        groups = u.get("groups", []) or []
        ents = []
        for g in groups:
            try:
                ent = await self.client.get_entity(g.get("id"))
                ents.append(ent)
            except Exception:
                logger.exception("resolve target failed for %s", g)
        ents = [e for e in ents if getattr(e, "id", None) != self.source_id]
        return ents

    async def _forward_now(self, msg):
        targets = await self._resolve_targets()
        if not targets:
            return
        u = users.get(str(self.uid), {})
        plan = u.get("plan", "free")
        if plan == "free" and len(targets) > 3:
            random.shuffle(targets)
            targets = targets[:3]
        for t in targets:
            try:
                await self.client.forward_messages(entity=t, messages=msg)
            except FloodWaitError as fe:
                logger.info("[%s] FloodWait %s sec", self.uid, fe.seconds)
                await asyncio.sleep(fe.seconds)
                try:
                    await self.client.forward_messages(entity=t, messages=msg)
                except Exception:
                    logger.exception("[%s] retry forward error", self.uid)
            except Exception:
                logger.exception("[%s] forward error", self.uid)
            await asyncio.sleep(PER_TARGET_DELAY)
        # free plan promo message appended
        if plan == "free":
            try:
                me = await bot.get_me()
                bot_username = getattr(me, "username", None)
                if bot_username:
                    bot_link = f"https://t.me/{bot_username}"
                    for t in targets:
                        try:
                            await self.client.send_message(entity=t, message=f"Reklama: {bot_link}")
                        except Exception:
                            logger.exception("promo send error")
                        await asyncio.sleep(1)
            except Exception:
                logger.exception("promo send failed")

    async def _repeater_loop(self):
        while True:
            try:
                if self.paused or not self.last_msg:
                    await asyncio.sleep(1)
                    continue
                u = users.get(str(self.uid), {})
                plan = u.get("plan", "free")
                if plan == "premium":
                    interval = int(u.get("interval_minutes", 1))
                else:
                    interval = int(u.get("interval_minutes", FREE_DEFAULT_MINUTES))
                # sleep interval minutes
                await asyncio.sleep(interval * 60)
                if self.paused or not self.last_msg:
                    continue
                await self._forward_now(self.last_msg)
            except asyncio.CancelledError:
                break
            except Exception:
                logger.exception("repeater_loop err")
                await asyncio.sleep(3)

    async def stop(self):
        try:
            if self.repeat_task:
                self.repeat_task.cancel()
        except Exception:
            pass
        try:
            await self.client.disconnect()
        except Exception:
            pass
        self.running = False
        logger.info("SessionWorker stopped for %s", self.uid)

# ---------- worker management ----------
async def ensure_worker_running(uid: int) -> (bool, str):
    uid = int(uid)
    if uid in active_workers and active_workers[uid].running:
        return True, "already"
    u = users.get(str(uid), {})
    if not u.get("session"):
        return False, "no_session"
    base = user_base(uid)
    sw = SessionWorker(uid, base, GLOBAL_API_ID, GLOBAL_API_HASH)
    ok, msg = await sw.start()
    if ok:
        active_workers[uid] = sw
        return True, "started"
    else:
        logger.info("ensure_worker_running failed for %s: %s", uid, msg)
        return False, msg

